<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  仅保留批量插入：MP BaseMapper 无批量 insert，逐条 insert 会产生 N 次往返。
  单表查询/删除已全部改为接口 default 方法（LambdaQueryWrapper）。
-->
<mapper namespace="edu.czu.cinema.domain.hall.mapper.SeatTemplateUnitMapper">

    <insert id="batchInsert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO seat_template_unit (template_id, y, x, status, label)
        VALUES
        <foreach collection="list" item="u" separator=",">
            (#{u.templateId}, #{u.y}, #{u.x}, #{u.status}, #{u.label})
        </foreach>
    </insert>

</mapper>
