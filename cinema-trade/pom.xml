<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>edu.czu.cinema</groupId>
        <artifactId>cinema-cloud</artifactId>
        <version>0.1.0</version>
    </parent>
    <artifactId>cinema-trade</artifactId>
    <!-- Export dependencies stay in Trade; other applications do not load POI. -->
    <dependencies><dependency><groupId>com.alibaba.csp</groupId><artifactId>sentinel-datasource-nacos</artifactId><version>1.8.9</version><exclusions><exclusion><groupId>com.alibaba.nacos</groupId><artifactId>nacos-client</artifactId></exclusion></exclusions></dependency><dependency><groupId>edu.czu.cinema</groupId><artifactId>cinema-starter-job</artifactId><version>${project.version}</version></dependency><dependency><groupId>edu.czu.cinema</groupId><artifactId>cinema-starter-seata</artifactId><version>${project.version}</version></dependency>
        <dependency>
            <groupId>edu.czu.cinema</groupId>
            <artifactId>cinema-starter-messaging</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>edu.czu.cinema</groupId>
            <artifactId>cinema-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>edu.czu.cinema</groupId>
            <artifactId>cinema-starter-web</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>edu.czu.cinema</groupId>
            <artifactId>cinema-starter-security</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>edu.czu.cinema</groupId>
            <artifactId>cinema-starter-data</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>edu.czu.cinema</groupId>
            <artifactId>cinema-starter-redis</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>edu.czu.cinema</groupId>
            <artifactId>cinema-starter-remote</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>edu.czu.cinema</groupId>
            <artifactId>cinema-starter-observe</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.38</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>${hutool.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId><artifactId>mapstruct</artifactId><version>${mapstruct.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.fesod</groupId><artifactId>fesod-sheet</artifactId><version>${fesod.version}</version>
            <exclusions>
                <!-- Spring JCL already provides this API; avoid a second discovery implementation. -->
                <exclusion><groupId>commons-logging</groupId><artifactId>commons-logging</artifactId></exclusion>
            </exclusions>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths combine.self="override">
                        <path><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId><version>1.18.38</version></path>
                        <path><groupId>org.projectlombok</groupId><artifactId>lombok-mapstruct-binding</artifactId><version>0.2.0</version></path>
                        <path><groupId>org.mapstruct</groupId><artifactId>mapstruct-processor</artifactId><version>${mapstruct.version}</version></path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <classifier>exec</classifier>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
