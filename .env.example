MYSQL_ROOT_PASSWORD=
IDENTITY_DB_PASSWORD=
CATALOG_DB_PASSWORD=
TRADE_DB_PASSWORD=
AI_DB_PASSWORD=
JWT_SECRET=
INTERNAL_SERVICE_KEY=
REDIS_PASSWORD=
NACOS_TOKEN_SECRET=
NACOS_IDENTITY_VALUE=
NACOS_USERNAME=nacos
NACOS_PASSWORD=
DASHSCOPE_API_KEY=local-placeholder

# 图片上传及影片资源转存（现有图片链接无需重新上传）
ALIYUN_OSS_AK=
ALIYUN_OSS_SK=
ALIYUN_OSS_ENDPOINT=https://oss-cn-chengdu.aliyuncs.com
ALIYUN_OSS_BUCKET=cinema-bucket
CAPTCHA_REQUIRED=true
WEB_PORT=8088
# Optional: comma-separated allowed browser origins; defaults follow WEB_PORT and Vite port 5173.
# CORS_ALLOWED_ORIGINS=https://cinema.example.com
INITIAL_ADMIN_PASSWORD=

# Created for the optional messaging group by tools/init-domain.py notify
NOTIFY_DB_PASSWORD=
# Created for the optional mq-search group by tools/init-domain.py search
SEARCH_DB_PASSWORD=

# Local coupon / AT transaction group (generated locally, never commit .env)
BENEFIT_DB_PASSWORD=
SEATA_DB_PASSWORD=
SEATA_CONSOLE_PASSWORD=
SEATA_SECURITY_SECRET=

# Local scheduler group (generated by tools/init-jobs.py)
JOB_DB_PASSWORD=
XXL_JOB_ACCESS_TOKEN=
XXL_JOB_ADMIN_PASSWORD=

# Local governance observer (generated by init-governance.py)
SENTINEL_DASHBOARD_PASSWORD=

# Optional local API documentation. Prefer local-stack.ps1 -EnableDocs for the selected group.
API_DOCS_ENABLED=false
API_DOCS_SERVICES=identity,catalog,trade,ai

# Local metrics group; generated by tools/init-metrics.py, never commit actual values.
CINEMA_METRICS_KEY=
GRAFANA_ADMIN_PASSWORD=

# Optional tracing group; generated by tools/init-tracing.py.
SKYWALKING_AUTH_TOKEN=
SKYWALKING_UI_PASSWORD=
